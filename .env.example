# Copiar a ".env" (que no se versiona) para cambiar estos valores:  cp .env.example .env
# Son credenciales de desarrollo local: el puerto solo escucha en 127.0.0.1.
# Los valores por defecto del docker-compose.yml son los mismos, así que el proyecto
# funciona aunque no exista el archivo .env.

POSTGRES_USER=happiness
POSTGRES_PASSWORD=happiness
POSTGRES_DB=happiness
POSTGRES_PORT=5432
