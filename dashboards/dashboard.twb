            <column-instance column='[Calculation_5300000000000048]' derivation='User' name='[usr:Calculation_5300000000000048:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0gnh9c50kyjs2p1awprvd09j5em9].[none:Calculation_5300000000000007:nk]'>
