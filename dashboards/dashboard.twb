    <worksheet name='Mapa'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#2a1e22' fontsize='13'>Error de predicción por país</run>
            <run>Æ&#10;</run>
            <run fontcolor='#6a5a5f' fontsize='9'>Error absoluto medio   </run>
            <run fontcolor='#eacdd5' fontsize='12'>■</run>
            <run fontcolor='#6a5a5f' fontsize='9'> menos de 0.2    </run>
            <run fontcolor='#cca3ae' fontsize='12'>■</run>
            <run fontcolor='#6a5a5f' fontsize='9'> 0.2 a 0.4    </run>
            <run fontcolor='#af7888' fontsize='12'>■</run>
            <run fontcolor='#6a5a5f' fontsize='9'> 0.4 a 0.6    </run>
            <run fontcolor='#8e4a5e' fontsize='12'>■</run>
            <run fontcolor='#6a5a5f' fontsize='9'> 0.6 a 0.8    </run>
            <run fontcolor='#6e1b34' fontsize='12'>■</run>
            <run fontcolor='#6a5a5f' fontsize='9'> más de 0.8    </run>
            <run fontcolor='#eae3dd' fontsize='12'>■</run>
            <run fontcolor='#6a5a5f' fontsize='9'> fuera de la selección</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_predictions+ (happiness)' name='federated.0gnh9c50kyjs2p1awprvd09j5em9' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p País' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;Todos&quot;'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
            <column caption='p Región' datatype='string' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;Todos&quot;'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
            <column caption='p Año' datatype='string' name='[Parameter 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;Todos&quot;'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gnh9c50kyjs2p1awprvd09j5em9'>
            <column caption='Región (es)' datatype='string' name='[Calculation_5300000000000001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [region]&#10;WHEN &quot;Sub-Saharan Africa&quot; THEN &quot;África subsahariana&quot;&#10;WHEN &quot;Central and Eastern Europe&quot; THEN &quot;Europa central y oriental&quot;&#10;WHEN &quot;Western Europe&quot; THEN &quot;Europa occidental&quot;&#10;WHEN &quot;Middle East and Northern Africa&quot; THEN &quot;Medio Oriente y N. de África&quot;&#10;WHEN &quot;Latin America and Caribbean&quot; THEN &quot;Latinoamérica y Caribe&quot;&#10;WHEN &quot;Southern Asia&quot; THEN &quot;Asia del Sur&quot;&#10;WHEN &quot;Eastern Asia&quot; THEN &quot;Asia oriental&quot;&#10;WHEN &quot;Southeastern Asia&quot; THEN &quot;Sudeste asiático&quot;&#10;WHEN &quot;Australia and New Zealand&quot; THEN &quot;Australia y N. Zelanda&quot;&#10;WHEN &quot;North America&quot; THEN &quot;Norteamérica&quot;&#10;ELSE IFNULL([region], &quot;Sin región&quot;)&#10;END' />
            </column>
            <column caption='País (mapa)' datatype='string' name='[Calculation_5300000000000002]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='// Nombres que el mapa de Tableau no reconoce, pasados a código ISO&#10;CASE [country_name]&#10;WHEN &quot;Congo (Brazzaville)&quot; THEN &quot;COG&quot;&#10;WHEN &quot;Congo (Kinshasa)&quot; THEN &quot;COD&quot;&#10;WHEN &quot;Ivory Coast&quot; THEN &quot;CIV&quot;&#10;WHEN &quot;Hong Kong&quot; THEN &quot;HKG&quot;&#10;WHEN &quot;Taiwan&quot; THEN &quot;TWN&quot;&#10;WHEN &quot;Puerto Rico&quot; THEN &quot;PRI&quot;&#10;WHEN &quot;South Korea&quot; THEN &quot;KOR&quot;&#10;WHEN &quot;Russia&quot; THEN &quot;RUS&quot;&#10;WHEN &quot;Syria&quot; THEN &quot;SYR&quot;&#10;WHEN &quot;Laos&quot; THEN &quot;LAO&quot;&#10;WHEN &quot;Moldova&quot; THEN &quot;MDA&quot;&#10;WHEN &quot;Iran&quot; THEN &quot;IRN&quot;&#10;WHEN &quot;Tanzania&quot; THEN &quot;TZA&quot;&#10;WHEN &quot;Vietnam&quot; THEN &quot;VNM&quot;&#10;WHEN &quot;Czech Republic&quot; THEN &quot;CZE&quot;&#10;WHEN &quot;Gambia&quot; THEN &quot;GMB&quot;&#10;WHEN &quot;Bolivia&quot; THEN &quot;BOL&quot;&#10;WHEN &quot;Venezuela&quot; THEN &quot;VEN&quot;&#10;WHEN &quot;Macedonia&quot; THEN &quot;MKD&quot;&#10;WHEN &quot;Palestinian Territories&quot; THEN &quot;PSE&quot;&#10;WHEN &quot;Swaziland&quot; THEN &quot;SWZ&quot;&#10;ELSE [country_name]&#10;END' />
            </column>
            <column caption='Año (texto)' datatype='string' name='[Calculation_5300000000000003]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([year])' />
            </column>
            <column caption='País' datatype='string' name='[Calculation_5300000000000004]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Copia sin rol geográfico, para mostrar el nombre original&#10;[country_name]' />
            </column>
            <column caption='Sel país' datatype='boolean' name='[Calculation_5300000000000005]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Todos&quot; OR [country_name] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Sel región' datatype='boolean' name='[Calculation_5300000000000006]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Todos&quot; OR [Calculation_5300000000000001] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Sel año' datatype='boolean' name='[Calculation_5300000000000007]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;Todos&quot; OR [Calculation_5300000000000003] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Sel lugar' datatype='boolean' name='[Calculation_5300000000000008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5300000000000005] AND [Calculation_5300000000000006]' />
            </column>
            <column caption='Llave estado' datatype='string' name='[Calculation_5300000000000010]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Cambia con cada clic para que la marca quede libre y se pueda volver a pulsar&#10;[Parameters].[Parameter 1] + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [Parameters].[Parameter 3]' />
            </column>
            <column caption='Todos' datatype='string' name='[Calculation_5300000000000011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
            <column caption='Clic país' datatype='string' name='[Calculation_5300000000000012]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Un segundo clic sobre el país elegido lo suelta&#10;IF [country_name] = [Parameters].[Parameter 1] THEN &quot;Todos&quot; ELSE [country_name] END' />
            </column>
            <column caption='Error del país' datatype='real' default-format='c0.00' name='[Calculation_5300000000000021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Error absoluto medio del país en el año elegido&#10;{FIXED [country_name] : AVG(IF [Calculation_5300000000000007] THEN [absolute_error] END)}' />
            </column>
            <column caption='Nivel de error (mapa)' datatype='string' name='[Calculation_5300000000000022]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT [Calculation_5300000000000008] THEN &quot;Apagado&quot;&#10;ELSEIF ISNULL([Calculation_5300000000000021]) THEN &quot;Sin datos&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.2 THEN &quot;1 · menos de 0.20&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.4 THEN &quot;2 · de 0.20 a 0.40&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.6 THEN &quot;3 · de 0.40 a 0.60&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.8 THEN &quot;4 · de 0.60 a 0.80&quot;&#10;ELSE &quot;5 · más de 0.80&quot;&#10;END' />
            </column>
            <column caption='MAE' datatype='real' default-format='c0.000' name='[Calculation_5300000000000035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([absolute_error])' />
            </column>
            <column caption='Predicciones' datatype='integer' name='[Calculation_5300000000000041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([prediction_id])' />
            </column>
            <column caption='Real promedio' datatype='real' default-format='c0.00' name='[Calculation_5300000000000047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([actual_score])' />
            </column>
            <column caption='Predicho promedio' datatype='real' default-format='c0.00' name='[Calculation_5300000000000048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([predicted_score])' />
            </column>
            <column caption='Absolute Error' datatype='real' name='[absolute_error]' role='measure' type='quantitative' />
            <column caption='Actual Score' datatype='real' name='[actual_score]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_5300000000000001]' derivation='None' name='[none:Calculation_5300000000000001:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5300000000000002]' derivation='None' name='[none:Calculation_5300000000000002:nk]' pivot='key' type='nominal' />
