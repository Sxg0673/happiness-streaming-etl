      </connection>
      <aliases enabled='yes' />
      <column caption='Región (es)' datatype='string' name='[Calculation_5300000000000001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [region]&#10;WHEN &quot;Sub-Saharan Africa&quot; THEN &quot;África subsahariana&quot;&#10;WHEN &quot;Central and Eastern Europe&quot; THEN &quot;Europa central y oriental&quot;&#10;WHEN &quot;Western Europe&quot; THEN &quot;Europa occidental&quot;&#10;WHEN &quot;Middle East and Northern Africa&quot; THEN &quot;Medio Oriente y N. de África&quot;&#10;WHEN &quot;Latin America and Caribbean&quot; THEN &quot;Latinoamérica y Caribe&quot;&#10;WHEN &quot;Southern Asia&quot; THEN &quot;Asia del Sur&quot;&#10;WHEN &quot;Eastern Asia&quot; THEN &quot;Asia oriental&quot;&#10;WHEN &quot;Southeastern Asia&quot; THEN &quot;Sudeste asiático&quot;&#10;WHEN &quot;Australia and New Zealand&quot; THEN &quot;Australia y N. Zelanda&quot;&#10;WHEN &quot;North America&quot; THEN &quot;Norteamérica&quot;&#10;ELSE IFNULL([region], &quot;Sin región&quot;)&#10;END' />
      </column>
      <column caption='País (mapa)' datatype='string' name='[Calculation_5300000000000002]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='// Nombres que el mapa de Tableau no reconoce, pasados a código ISO&#10;CASE [country_name]&#10;WHEN &quot;Congo (Brazzaville)&quot; THEN &quot;COG&quot;&#10;WHEN &quot;Congo (Kinshasa)&quot; THEN &quot;COD&quot;&#10;WHEN &quot;Ivory Coast&quot; THEN &quot;CIV&quot;&#10;WHEN &quot;Hong Kong&quot; THEN &quot;HKG&quot;&#10;WHEN &quot;Taiwan&quot; THEN &quot;TWN&quot;&#10;WHEN &quot;Puerto Rico&quot; THEN &quot;PRI&quot;&#10;WHEN &quot;South Korea&quot; THEN &quot;KOR&quot;&#10;WHEN &quot;Russia&quot; THEN &quot;RUS&quot;&#10;WHEN &quot;Syria&quot; THEN &quot;SYR&quot;&#10;WHEN &quot;Laos&quot; THEN &quot;LAO&quot;&#10;WHEN &quot;Moldova&quot; THEN &quot;MDA&quot;&#10;WHEN &quot;Iran&quot; THEN &quot;IRN&quot;&#10;WHEN &quot;Tanzania&quot; THEN &quot;TZA&quot;&#10;WHEN &quot;Vietnam&quot; THEN &quot;VNM&quot;&#10;WHEN &quot;Czech Republic&quot; THEN &quot;CZE&quot;&#10;WHEN &quot;Gambia&quot; THEN &quot;GMB&quot;&#10;WHEN &quot;Bolivia&quot; THEN &quot;BOL&quot;&#10;WHEN &quot;Venezuela&quot; THEN &quot;VEN&quot;&#10;WHEN &quot;Macedonia&quot; THEN &quot;MKD&quot;&#10;WHEN &quot;Palestinian Territories&quot; THEN &quot;PSE&quot;&#10;WHEN &quot;Swaziland&quot; THEN &quot;SWZ&quot;&#10;ELSE [country_name]&#10;END' />
      </column>
      <column caption='Año (texto)' datatype='string' name='[Calculation_5300000000000003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([year])' />
      </column>
      <column caption='País' datatype='string' name='[Calculation_5300000000000004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Copia sin rol geográfico, para mostrar el nombre original&#10;[country_name]' />
      </column>
      <column caption='Sel país' datatype='boolean' name='[Calculation_5300000000000005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Todos&quot; OR [country_name] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Sel región' datatype='boolean' name='[Calculation_5300000000000006]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Todos&quot; OR [Calculation_5300000000000001] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Sel año' datatype='boolean' name='[Calculation_5300000000000007]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;Todos&quot; OR [Calculation_5300000000000003] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='Sel lugar' datatype='boolean' name='[Calculation_5300000000000008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5300000000000005] AND [Calculation_5300000000000006]' />
      </column>
      <column caption='En selección' datatype='boolean' name='[Calculation_5300000000000009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5300000000000008] AND [Calculation_5300000000000007]' />
      </column>
      <column caption='Llave estado' datatype='string' name='[Calculation_5300000000000010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Cambia con cada clic para que la marca quede libre y se pueda volver a pulsar&#10;[Parameters].[Parameter 1] + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [Parameters].[Parameter 3]' />
      </column>
      <column caption='Todos' datatype='string' name='[Calculation_5300000000000011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Todos&quot;' />
      </column>
      <column caption='Clic país' datatype='string' name='[Calculation_5300000000000012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Un segundo clic sobre el país elegido lo suelta&#10;IF [country_name] = [Parameters].[Parameter 1] THEN &quot;Todos&quot; ELSE [country_name] END' />
      </column>
      <column caption='Clic región' datatype='string' name='[Calculation_5300000000000013]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5300000000000001] = [Parameters].[Parameter 2] THEN &quot;Todos&quot; ELSE [Calculation_5300000000000001] END' />
      </column>
      <column caption='Predicciones del año en el lugar' datatype='integer' name='[Calculation_5300000000000014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Cuántas predicciones tiene cada año dentro del país o la región elegidos&#10;{FIXED [year] : SUM(IF [Calculation_5300000000000008] THEN 1 ELSE 0 END)}' />
      </column>
      <column caption='Clic año' datatype='string' name='[Calculation_5300000000000015]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Un año sin datos en la selección no cambia nada; un segundo clic suelta el año&#10;IF [Calculation_5300000000000014] = 0 THEN [Parameters].[Parameter 3] ELSEIF [Calculation_5300000000000003] = [Parameters].[Parameter 3] THEN &quot;Todos&quot; ELSE [Calculation_5300000000000003] END' />
      </column>
      <column caption='Clic ficha' datatype='string' name='[Calculation_5300000000000016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Todos&quot; THEN [country_name] ELSE [Parameters].[Parameter 1] END' />
      </column>
      <column caption='Región activa' datatype='string' name='[Calculation_5300000000000017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// La región elegida, o la del país elegido&#10;IF [Parameters].[Parameter 1] &lt;&gt; &quot;Todos&quot; THEN {FIXED : MAX(IF [country_name] = [Parameters].[Parameter 1] THEN [Calculation_5300000000000001] END)}&#10;ELSE [Parameters].[Parameter 2] END' />
      </column>
      <column caption='Color región' datatype='string' name='[Calculation_5300000000000018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5300000000000017] = &quot;Todos&quot; THEN &quot;Base&quot; ELSEIF [Calculation_5300000000000001] = [Calculation_5300000000000017] THEN &quot;Elegido&quot; ELSE &quot;Tenue&quot; END' />
      </column>
      <column caption='Color punto' datatype='string' name='[Calculation_5300000000000019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Todos&quot; AND [Parameters].[Parameter 2] = &quot;Todos&quot; THEN &quot;Base&quot; ELSEIF [Calculation_5300000000000008] THEN &quot;Elegido&quot; ELSE &quot;Tenue&quot; END' />
      </column>
      <column caption='Color año' datatype='string' name='[Calculation_5300000000000020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5300000000000014] = 0 THEN &quot;Tenue&quot; ELSEIF [Parameters].[Parameter 3] = &quot;Todos&quot; THEN &quot;Base&quot; ELSEIF [Calculation_5300000000000003] = [Parameters].[Parameter 3] THEN &quot;Elegido&quot; ELSE &quot;Tenue&quot; END' />
      </column>
      <column caption='Error del país' datatype='real' default-format='c0.00' name='[Calculation_5300000000000021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Error absoluto medio del país en el año elegido&#10;{FIXED [country_name] : AVG(IF [Calculation_5300000000000007] THEN [absolute_error] END)}' />
      </column>
      <column caption='Nivel de error (mapa)' datatype='string' name='[Calculation_5300000000000022]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT [Calculation_5300000000000008] THEN &quot;Apagado&quot;&#10;ELSEIF ISNULL([Calculation_5300000000000021]) THEN &quot;Sin datos&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.2 THEN &quot;1 · menos de 0.20&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.4 THEN &quot;2 · de 0.20 a 0.40&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.6 THEN &quot;3 · de 0.40 a 0.60&quot;&#10;ELSEIF [Calculation_5300000000000021] &lt; 0.8 THEN &quot;4 · de 0.60 a 0.80&quot;&#10;ELSE &quot;5 · más de 0.80&quot;&#10;END' />
      </column>
      <column caption='Ficha etiqueta' datatype='string' name='[Calculation_5300000000000023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Sin país elegido lista países; con país elegido lista sus años&#10;IF [Parameters].[Parameter 1] = &quot;Todos&quot; THEN [country_name] ELSE [Calculation_5300000000000003] END' />
      </column>
      <column caption='Ficha rótulo' datatype='string' name='[Calculation_5300000000000024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] &lt;&gt; &quot;Todos&quot; THEN &quot;PAÍS SELECCIONADO&quot;&#10;ELSEIF [Parameters].[Parameter 2] &lt;&gt; &quot;Todos&quot; THEN &quot;REGIÓN SELECCIONADA&quot;&#10;ELSE &quot;DÓNDE MÁS SE EQUIVOCA EL MODELO&quot; END' />
      </column>
      <column caption='Ficha título' datatype='string' name='[Calculation_5300000000000025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] &lt;&gt; &quot;Todos&quot; THEN [Parameters].[Parameter 1]&#10;ELSEIF [Parameters].[Parameter 2] &lt;&gt; &quot;Todos&quot; THEN [Parameters].[Parameter 2]&#10;ELSE &quot;Países con mayor error&quot; END' />
      </column>
      <column caption='Alcance' datatype='string' name='[Calculation_5300000000000026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(IF [Parameters].[Parameter 1] &lt;&gt; &quot;Todos&quot; THEN [Parameters].[Parameter 1] ELSEIF [Parameters].[Parameter 2] &lt;&gt; &quot;Todos&quot; THEN [Parameters].[Parameter 2] ELSE &quot;Todo el mundo&quot; END)&#10;+ &quot; · &quot; +&#10;(IF [Parameters].[Parameter 3] = &quot;Todos&quot; THEN &quot;2015–2019&quot; ELSE [Parameters].[Parameter 3] END)' />
      </column>
      <column caption='Hay filtro' datatype='boolean' name='[Calculation_5300000000000027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] &lt;&gt; &quot;Todos&quot; OR [Parameters].[Parameter 2] &lt;&gt; &quot;Todos&quot; OR [Parameters].[Parameter 3] &lt;&gt; &quot;Todos&quot;' />
      </column>
      <column caption='Restablecer (con filtro)' datatype='string' name='[Calculation_5300000000000028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5300000000000027] THEN &quot;↺  Restablecer filtros&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Restablecer (sin filtro)' datatype='string' name='[Calculation_5300000000000029]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5300000000000027] THEN &quot;&quot; ELSE &quot;↺  Restablecer&quot; END' />
      </column>
      <column caption='Real del año' datatype='real' name='[Calculation_5300000000000030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [year] : AVG(IF [Calculation_5300000000000008] THEN [actual_score] END)}' />
      </column>
      <column caption='Predicho del año' datatype='real' name='[Calculation_5300000000000031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [year] : AVG(IF [Calculation_5300000000000008] THEN [predicted_score] END)}' />
      </column>
      <column caption='Tendencia mínimo' datatype='real' name='[Calculation_5300000000000032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MIN(IF [Calculation_5300000000000030] &lt; [Calculation_5300000000000031] THEN [Calculation_5300000000000030] ELSE [Calculation_5300000000000031] END)}' />
      </column>
      <column caption='Tendencia máximo' datatype='real' name='[Calculation_5300000000000033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [Calculation_5300000000000030] &gt; [Calculation_5300000000000031] THEN [Calculation_5300000000000030] ELSE [Calculation_5300000000000031] END)}' />
      </column>
      <column caption='Tendencia piso' datatype='real' name='[Calculation_5300000000000034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Valor que se resta a las dos líneas. Deja aire por debajo para las etiquetas&#10;[Calculation_5300000000000032] - 0.6 * ([Calculation_5300000000000033] - [Calculation_5300000000000032]) - 0.05' />
      </column>
      <column caption='MAE' datatype='real' default-format='c0.000' name='[Calculation_5300000000000035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([absolute_error])' />
      </column>
      <column caption='RMSE' datatype='real' default-format='c0.000' name='[Calculation_5300000000000036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT(AVG([prediction_error] * [prediction_error]))' />
      </column>
      <column caption='R²' datatype='real' default-format='c0.000' name='[Calculation_5300000000000037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 1 - SSE/SST. SST = suma(a²) - suma(a)²/n. Con menos de 3 predicciones no se calcula&#10;IF COUNT([prediction_id]) &gt;= 3 THEN&#10;  1 - SUM([prediction_error] * [prediction_error])&#10;  / (SUM([actual_score] * [actual_score]) - SUM([actual_score]) * SUM([actual_score]) / COUNT([actual_score]))&#10;END' />
      </column>
      <column caption='R² en milésimas' datatype='real' name='[Calculation_5300000000000038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(1000 * [Calculation_5300000000000037])' />
      </column>
      <column caption='R² (texto)' datatype='string' name='[Calculation_5300000000000039]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Texto con 3 decimales, o una raya si no se puede calcular&#10;IF ISNULL([Calculation_5300000000000037]) THEN &quot;—&quot;&#10;ELSE (IF [Calculation_5300000000000038] &lt; 0 THEN &quot;-&quot; ELSE &quot;&quot; END)&#10;  + STR(INT(ABS([Calculation_5300000000000038]) / 1000)) + &quot;.&quot;&#10;  + RIGHT(&quot;00&quot; + STR(INT(ABS([Calculation_5300000000000038])) % 1000), 3)&#10;END' />
      </column>
      <column caption='Sesgo' datatype='real' default-format='c+0.000;-0.000' name='[Calculation_5300000000000040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Positivo: el modelo predice de más&#10;AVG([prediction_error])' />
      </column>
      <column caption='Predicciones' datatype='integer' name='[Calculation_5300000000000041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([prediction_id])' />
      </column>
      <column caption='Países' datatype='integer' name='[Calculation_5300000000000042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([country_id])' />
      </column>
      <column caption='Eventos recibidos' datatype='integer' name='[Calculation_5300000000000043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([raw_event_id (raw_happiness_events)])' />
      </column>
      <column caption='Eventos válidos' datatype='integer' name='[Calculation_5300000000000044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;VALID&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='% eventos válidos' datatype='real' default-format='p0.0%' name='[Calculation_5300000000000045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5300000000000044] / [Calculation_5300000000000043]' />
      </column>
      <column caption='Predicción perfecta' datatype='real' default-format='c0.00' name='[Calculation_5300000000000046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Diagonal de la dispersión: predicho = real&#10;AVG([actual_score])' />
      </column>
      <column caption='Real promedio' datatype='real' default-format='c0.00' name='[Calculation_5300000000000047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([actual_score])' />
      </column>
      <column caption='Predicho promedio' datatype='real' default-format='c0.00' name='[Calculation_5300000000000048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([predicted_score])' />
      </column>
      <column caption='Ficha orden' datatype='real' name='[Calculation_5300000000000049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Países: mayor error primero. Años: en orden&#10;IF [Parameters].[Parameter 1] = &quot;Todos&quot; THEN AVG([absolute_error]) ELSE -MIN([year]) END' />
      </column>
      <column caption='Eventos con esquema inválido' datatype='integer' name='[Calculation_5300000000000050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;INVALID_SCHEMA&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Eventos con valores inválidos' datatype='integer' name='[Calculation_5300000000000051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;INVALID_VALUES&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Eventos con error de predicción' datatype='integer' name='[Calculation_5300000000000052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;PREDICTION_ERROR&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Versión del modelo' datatype='string' name='[Calculation_5300000000000053]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN([model_version])' />
      </column>
      <column caption='Ficha subtítulo' datatype='string' name='[Calculation_5300000000000054]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] &lt;&gt; &quot;Todos&quot; THEN&#10;  MIN([Calculation_5300000000000001]) + &quot; · &quot; + STR(COUNT([prediction_id]))&#10;  + (IF COUNT([prediction_id]) = 1 THEN &quot; predicción&quot; ELSE &quot; predicciones&quot; END)&#10;ELSEIF [Parameters].[Parameter 2] &lt;&gt; &quot;Todos&quot; THEN&#10;  STR(COUNTD([country_id])) + &quot; países · &quot; + STR(COUNT([prediction_id])) + &quot; predicciones&quot;&#10;ELSE &quot;De mayor a menor error · clic para elegir&quot;&#10;END' />
      </column>
      <column caption='Real' datatype='real' default-format='c0.00' name='[Calculation_5300000000000055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([actual_score])' />
      </column>
      <column caption='Pred.' datatype='real' default-format='c0.00' name='[Calculation_5300000000000056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([predicted_score])' />
      </column>
      <column caption='Error' datatype='real' default-format='c0.00' name='[Calculation_5300000000000057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Error absoluto medio de la fila&#10;AVG([absolute_error])' />
      </column>
      <column caption='MAE del año en el lugar' datatype='real' default-format='c0.00' name='[Calculation_5300000000000058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Calculation_5300000000000008] THEN [absolute_error] END)' />
      </column>
      <column caption='MAE del año (texto)' datatype='string' name='[Calculation_5300000000000059]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_5300000000000058]) THEN &quot;sin datos&quot; ELSE &quot;MAE &quot; + STR(INT(ROUND([Calculation_5300000000000058] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_5300000000000058] * 100)) % 100), 2) END' />
      </column>
      <column caption='Año (número)' datatype='integer' default-format='c0' name='[Calculation_5300000000000060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([year])' />
      </column>
      <column caption='Real (línea)' datatype='real' default-format='c0.00' name='[Calculation_5300000000000061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Promedio real menos el piso común de la tendencia&#10;AVG([actual_score]) - MIN([Calculation_5300000000000034])' />
      </column>
      <column caption='Predicho (línea)' datatype='real' default-format='c0.00' name='[Calculation_5300000000000062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([predicted_score]) - MIN([Calculation_5300000000000034])' />
