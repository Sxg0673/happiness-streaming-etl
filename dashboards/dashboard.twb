    <worksheet name='KPI Predicciones'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_predictions+ (happiness)' name='federated.0gnh9c50kyjs2p1awprvd09j5em9' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p País' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;Todos&quot;'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
            <column caption='p Región' datatype='string' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;Todos&quot;'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
            <column caption='p Año' datatype='string' name='[Parameter 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;Todos&quot;'>
              <calculation class='tableau' formula='&quot;Todos&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gnh9c50kyjs2p1awprvd09j5em9'>
            <column caption='Región (es)' datatype='string' name='[Calculation_5300000000000001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [region]&#10;WHEN &quot;Sub-Saharan Africa&quot; THEN &quot;África subsahariana&quot;&#10;WHEN &quot;Central and Eastern Europe&quot; THEN &quot;Europa central y oriental&quot;&#10;WHEN &quot;Western Europe&quot; THEN &quot;Europa occidental&quot;&#10;WHEN &quot;Middle East and Northern Africa&quot; THEN &quot;Medio Oriente y N. de África&quot;&#10;WHEN &quot;Latin America and Caribbean&quot; THEN &quot;Latinoamérica y Caribe&quot;&#10;WHEN &quot;Southern Asia&quot; THEN &quot;Asia del Sur&quot;&#10;WHEN &quot;Eastern Asia&quot; THEN &quot;Asia oriental&quot;&#10;WHEN &quot;Southeastern Asia&quot; THEN &quot;Sudeste asiático&quot;&#10;WHEN &quot;Australia and New Zealand&quot; THEN &quot;Australia y N. Zelanda&quot;&#10;WHEN &quot;North America&quot; THEN &quot;Norteamérica&quot;&#10;ELSE IFNULL([region], &quot;Sin región&quot;)&#10;END' />
            </column>
            <column caption='Año (texto)' datatype='string' name='[Calculation_5300000000000003]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([year])' />
            </column>
            <column caption='Sel país' datatype='boolean' name='[Calculation_5300000000000005]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Todos&quot; OR [country_name] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Sel región' datatype='boolean' name='[Calculation_5300000000000006]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Todos&quot; OR [Calculation_5300000000000001] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Sel año' datatype='boolean' name='[Calculation_5300000000000007]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;Todos&quot; OR [Calculation_5300000000000003] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Sel lugar' datatype='boolean' name='[Calculation_5300000000000008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5300000000000005] AND [Calculation_5300000000000006]' />
            </column>
            <column caption='En selección' datatype='boolean' name='[Calculation_5300000000000009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5300000000000008] AND [Calculation_5300000000000007]' />
            </column>
            <column caption='Predicciones' datatype='integer' name='[Calculation_5300000000000041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([prediction_id])' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_5300000000000009]' derivation='None' name='[none:Calculation_5300000000000009:nk]' pivot='key' type='nominal' />
            <column caption='Prediction Id' datatype='integer' name='[prediction_id]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5300000000000041]' derivation='User' name='[usr:Calculation_5300000000000041:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0gnh9c50kyjs2p1awprvd09j5em9].[none:Calculation_5300000000000009:nk]'>
            <groupfilter function='member' level='[none:Calculation_5300000000000009:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
